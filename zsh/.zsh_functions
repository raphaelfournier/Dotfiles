}

function hosts-block {
    sudo ln -iv /etc/hosts-blocking /etc/hosts
    # Flush DNS cache
    sudo dscacheutil -flushcache;sudo killall -HUP mDNSResponder
}

function hosts-unblock {
    sudo ln -iv /etc/hosts-nonblocking /etc/hosts
    # Flush DNS cache
    sudo dscacheutil -flushcache;sudo killall -HUP mDNSResponder
}

fr () { 
  find ./ -iname "*"$@"*" -printf "%T@ %Td-%Tb-%TY %Tk:%TM %p\n" | sort -n | cut -d " " -f 2- | grep -i "$@" ; 
}

bkp() {
  if [[ $# -ne 1 ]]; then
    echo "Usage: bkp <filename>"
    return 1
  fi

  local file="$1"
  
  if [[ ! -f "$file" ]]; then
    echo "Error: file '$file' does not exist."
    return 1
  fi

  local base="${file%.*}"
  local ext="${file##*.}"

  # Handle files without extension
  if [[ "$base" == "$file" ]]; then
    cp -v "$file" "${file}-bkp"
  else
    cp -v "$file" "${base}-bkp.${ext}"
  fi
}

toggle-ads() {
    local LINK="/etc/hosts.d"
    local STRICT="/etc/hosts.profiles/adsBlocked"
    local NONE="/etc/hosts.profiles/adsAllowed"

    if [[ "$(readlink -f "$LINK")" == "$STRICT" ]]; then
        echo "🔓 Allowing ads..."
        sudo rm "$LINK"
        sudo ln -s "$NONE" "$LINK"
        echo "🔓 Ads ALLOWED (Profile: /etc/hosts.profiles/adsAllowed)"
    else
        echo "🛡️ Disabling ads..."
        sudo rm "$LINK"
        sudo ln -s "$STRICT" "$LINK"
        echo "🛡️  Ads BLOCKED (Profile: /etc/hosts.profiles/adsBlocked)"
    fi

    # Rebuild the hosts file
    sudo hosts-gen

    # Optional: Flush DNS cache if you use systemd-resolved
    if command -v resolvectl >/dev/null; then
        sudo resolvectl flush-caches
    fi
}

parufind() {paru -Sl | awk \'{print $2($4=="" ? "" : " \*")}\' | fzf -q "$1" -m --preview \'cat <(echo {1} | cut -d " " -f 1 | paru -Si -) <(echo {1} | cut -d " " -f 1 | paru -Fl - | awk "{print $2}")\' | cut -d " " -f 1 | xargs -ro paru -S}

# Quickly copy a template directory into the current directory
mkfromtemplate() {
  local templates_dir="${HOME}/Templates"

  # Ensure the Templates directory exists
  if [[ ! -d "$templates_dir" ]]; then
    echo "Error: Directory '$templates_dir' does not exist." >&2
    return 1
  fi

  # Select a template folder using fzf
  local selected_template
  selected_template=$(find "$templates_dir" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | fzf --prompt="Select Template > ")

  # If a selection was made, copy its contents to the current directory
  if [[ -n "$selected_template" ]]; then
    local src_dir="${templates_dir}/${selected_template}"
    
    # Copy contents (including hidden files) into current directory
    cp -r "$src_dir"/* "$src_dir"/* . 2>/dev/null
    echo "Copied '$selected_template' template to current directory."
  else
    echo "No template selected."
  fi
}
